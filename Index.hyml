<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Interview Practice</title>
<style>
  body { font-family: system-ui, sans-serif; background:#f4f4f2; margin:0; color:#1a1a1a; }
  .wrap { max-width:520px; margin:0 auto; padding:20px; }
  h1 { font-size:24px; }
  .card { background:#fff; border-radius:14px; padding:18px; margin-bottom:16px; box-shadow:0 1px 4px rgba(0,0,0,.08); }
  label { display:block; margin:12px 0 6px; font-weight:600; }
  select, textarea, button { width:100%; font-size:16px; padding:12px; border-radius:10px; border:1px solid #ccc; box-sizing:border-box; }
  button { background:#111; color:#fff; border:none; margin-top:12px; cursor:pointer; }
  button.secondary { background:#e5e5e2; color:#111; }
  .hidden { display:none; }
  .q { font-size:20px; font-weight:600; }
  .fb { border-top:1px solid #eee; padding-top:12px; margin-top:12px; }
  .small { color:#666; font-size:14px; }
</style>
</head>
<body>
<div class="wrap">
  <h1>Interview Practice</h1>

  <!-- Screen 1: setup -->
  <div id="setup" class="card">
    <label>Job</label>
    <select id="job">
      <option value="forklift driver">Forklift driver</option>
      <option value="production operator">Production operator</option>
      <option value="warehouse worker">Warehouse worker</option>
      <option value="delivery driver">Delivery driver</option>
      <option value="cleaner">Cleaner</option>
    </select>
    <label>Interview language</label>
    <select id="lang">
      <option value="fr-FR">Français</option>
      <option value="en-GB">English</option>
      <option value="es-ES">Español</option>
    </select>
    <button onclick="startInterview()">Start interview</button>
  </div>

  <!-- Screen 2: interview -->
  <div id="interview" class="card hidden">
    <div class="small" id="progress"></div>
    <p class="q" id="question"></p>
    <button class="secondary" onclick="speakQuestion()">🔊 Hear the question again</button>
    <label>Your answer</label>
    <textarea id="answer" rows="4" placeholder="Speak with the microphone or type here"></textarea>
    <button class="secondary" id="micBtn" onclick="listen()">🎤 Speak your answer</button>
    <button onclick="nextQuestion()">Next</button>
  </div>

  <!-- Screen 3: feedback -->
  <div id="feedback" class="card hidden">
    <h2>Your feedback</h2>
    <div id="fbContent" class="small">Analysing your answers…</div>
    <button onclick="location.reload()">Practise again</button>
  </div>
</div>

<script>
const QUESTIONS = {
  "fr-FR": [
    "Pouvez-vous vous présenter en quelques phrases ?",
    "Pourquoi voulez-vous ce poste de {job} ?",
    "Quelle est votre expérience dans ce domaine ?",
    "Comment respectez-vous les règles de sécurité au travail ?",
    "Comment gérez-vous le stress ou une journée très chargée ?"
  ],
  "en-GB": [
    "Can you introduce yourself in a few sentences?",
    "Why do you want this {job} position?",
    "What experience do you have in this field?",
    "How do you follow safety rules at work?",
    "How do you handle stress or a very busy day?"
  ],
  "es-ES": [
    "¿Puede presentarse en pocas frases?",
    "¿Por qué quiere este puesto de {job}?",
    "¿Qué experiencia tiene en este sector?",
    "¿Cómo cumple las normas de seguridad en el trabajo?",
    "¿Cómo gestiona el estrés o un día con mucho trabajo?"
  ]
};

let state = { job:"", lang:"", index:0, qs:[], answers:[] };

function show(id){
  ["setup","interview","feedback"].forEach(s => document.getElementById(s).classList.add("hidden"));
  document.getElementById(id).classList.remove("hidden");
}

function startInterview(){
  state.job = document.getElementById("job").value;
  state.lang = document.getElementById("lang").value;
  state.qs = QUESTIONS[state.lang].map(q => q.replace("{job}", state.job));
  state.index = 0; state.answers = [];
  show("interview");
  showQuestion();
}

function showQuestion(){
  document.getElementById("progress").textContent = "Question " + (state.index+1) + " of " + state.qs.length;
  document.getElementById("question").textContent = state.qs[state.index];
  document.getElementById("answer").value = "";
  speakQuestion();
}

function speakQuestion(){
  const u = new SpeechSynthesisUtterance(state.qs[state.index]);
  u.lang = state.lang;
  speechSynthesis.cancel();
  speechSynthesis.speak(u);
}

function listen(){
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if(!SR){ alert("Voice input is not supported in this browser. Please type your answer."); return; }
  const rec = new SR();
  rec.lang = state.lang;
  rec.onresult = e => { document.getElementById("answer").value = e.results[0][0].transcript; };
  rec.start();
}

async function nextQuestion(){
  const a = document.getElementById("answer").value.trim();
  state.answers.push(a || "(no answer)");
  state.index++;
  if(state.index < state.qs.length){ showQuestion(); }
  else { show("feedback"); await getFeedback(); }
}

async function getFeedback(){
  const box = document.getElementById("fbContent");
  try{
    const res = await fetch("/api/feedback", {
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body: JSON.stringify({ job:state.job, lang:state.lang, questions:state.qs, answers:state.answers })
    });
    const data = await res.json();
    box.innerHTML = data.feedback.map((f,i) =>
      '<div class="fb"><b>Q' + (i+1) + ': ' + state.qs[i] + '</b><br>' +
      '<i>Your answer:</i> ' + state.answers[i] + '<br>' +
      '<i>Feedback:</i> ' + f.comment + '<br>' +
      '<i>Better way to say it:</i> ' + f.better + '</div>'
    ).join("") + '<div class="fb"><b>Phrases to practise</b><br>' + data.phrases.join("<br>") + '</div>';
  }catch(e){
    box.textContent = "Feedback is not connected yet. Add the server file from Part 2.";
  }
}
</script>
</body>
</html>
